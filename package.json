{
  "name": "sigmet-poc",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "vinext dev --host 127.0.0.1 --port 5173",
    "lint": "oxlint app lib vite.config.ts components/ui/slider.tsx",
    "format": "oxfmt",
    "test": "node --experimental-strip-types --test tests/replay.test.mjs",
    "typecheck": "tsc --noEmit",
    "data:build": ".venv/bin/python scripts/pipeline.py",
    "data:check": ".venv/bin/python scripts/pipeline.py --check",
    "test:pipeline": ".venv/bin/python -m unittest discover -s tests -p \"test_*.py\"",
    "data:web": ".venv/bin/python scripts/pipeline.py --web-only",
    "symbols:download": ".venv/bin/python scripts/download_symbols.py",
    "predev": "node scripts/prepare-map-worker.mjs",
    "prebuild": "node scripts/prepare-map-worker.mjs",
    "prestart": "node scripts/prepare-map-worker.mjs"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "@shadcn/react": "0.3.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "date-fns": "4.1.0",
    "embla-carousel-react": "8.5.2",
    "input-otp": "1.4.2",
    "lucide-react": "1.31.0",
    "maplibre-gl": "^6.7.0",
    "react": "19.2.8",
    "react-day-picker": "9.8.1",
    "react-dom": "19.2.8",
    "react-resizable-panels": "4.5.8",
    "react-server-dom-webpack": "19.2.8",
    "recharts": "3.8.0",
    "shadcn": "4.18.0",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0",
    "vinext": "1.0.0-beta.9"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.54.4",
    "@cloudflare/workers-types": "5.20260905.1",
    "@openai/sites-vite-plugin": "0.2.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.34",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vite": "8.2.2",
    "wrangler": "4.129.0"
  },
  "type": "module"
}
